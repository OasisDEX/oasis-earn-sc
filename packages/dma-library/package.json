{
  "name": "@oasisdex/dma-library",
  "version": "0.6.76",
  "typings": "lib/index.d.ts",
  "types": "lib/index.d.ts",
  "main": "lib/index.js",
  "targets": {
    "main": {
      "optimize": true
    }
  },
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "npx parcel build ./src/index.ts --dist-dir ./lib",
    "build:dev": "npx parcel build ./src/index.ts --dist-dir ./lib --no-optimize --no-content-hash",
    "clean": "rm -rf lib && rm -f tsconfig.lint.tsbuildinfo",
    "lint": "yarn eslint . --ext .ts --max-warnings=0 && yarn tsc --build ./tsconfig.lint.json",
    "lint:fix": "yarn eslint . --fix --ext .ts",
    "test": "yarn mocha -r ts-node/register -r tsconfig-paths/register 'test/**/*.ts'",
    "linked": "yarn link",
    "unlinked": "yarn unlink",
    "generate": "DOTENV_CONFIG_PATH=../../.env graphql-codegen -r dotenv/config --config codegen_aave_like.yml && DOTENV_CONFIG_PATH=../../.env graphql-codegen -r dotenv/config --config codegen_ajna_v2.yml"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "bignumber.js": "9.0.1",
    "ethers": "^5.7.2",
    "graphql-request": "6",
    "graphql-tag": "^2.12.6"
  },
  "nx": {
    "implicitDependencies": [
      "@oasisdex/domain"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.1",
    "chai": "^4.3.7",
    "graphql": "^16.0.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
